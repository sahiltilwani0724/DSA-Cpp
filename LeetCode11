class Solution {
public:
    int maxArea(vector<int>& height) {
        int maxA=0;
        
        for(int i=0;i<height.size();i++){
            for(int j=i+1;j<height.size();j++){
                int h = min(height[i],height[j]);
                int w = j-i;
                int mul=h*w;
                if(mul>maxA){
                    maxA=mul;
                }
            }
        }
        return maxA;
    }
};
