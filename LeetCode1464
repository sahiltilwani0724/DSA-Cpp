class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int maxi=0;
        for(int i=0;i<nums.size();i++){
            for(int j=0;j<nums.size();j++){
              int sum =(nums[i]-1)*(nums[j]-1);
              if(sum>maxi && i!=j){
                maxi=sum;
              }
            }
        }
        return maxi;
        
    }
};
